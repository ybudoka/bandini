{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "--ignore=tests/test_navigateur.py"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "files.exclude": { "**/__pycache__": true, ".pytest_cache": true, ".ruff_cache": true },
  "search.exclude": { ".venv": true, "uv.lock": true },
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff", "editor.formatOnSave": false },

  // Les couleurs de Baie-des-Brumes : nuit, brume, or. Une fenetre Bandini
  // se reconnait d'un coup d'oeil a cote de gestion-dojo et du site de jeux.
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#0b0a12",
    "titleBar.activeForeground": "#efe6d0",
    "titleBar.inactiveBackground": "#0b0a12",
    "titleBar.inactiveForeground": "#8a8399",
    "activityBar.background": "#0b0a12",
    "activityBar.foreground": "#e8b33c",
    "activityBar.inactiveForeground": "#6f6884",
    "activityBarBadge.background": "#e8b33c",
    "activityBarBadge.foreground": "#0b0a12",
    "sideBar.background": "#13111f",
    "sideBar.foreground": "#d8d0e6",
    "sideBarSectionHeader.background": "#1c1a2b",
    "sideBarTitle.foreground": "#e8b33c",
    "editor.background": "#15131f",
    "editor.foreground": "#e6dfd0",
    "editorLineNumber.foreground": "#4e4866",
    "editorLineNumber.activeForeground": "#e8b33c",
    "editor.lineHighlightBackground": "#1c1a2b",
    "editor.selectionBackground": "#3a3260",
    "editorCursor.foreground": "#e8b33c",
    "editorGutter.background": "#15131f",
    "editorGroupHeader.tabsBackground": "#0b0a12",
    "tab.activeBackground": "#15131f",
    "tab.activeForeground": "#efe6d0",
    "tab.inactiveBackground": "#0b0a12",
    "tab.inactiveForeground": "#8a8399",
    "tab.activeBorderTop": "#e8b33c",
    "tab.border": "#0b0a12",
    "panel.background": "#13111f",
    "panel.border": "#2a2640",
    "terminal.background": "#0b0a12",
    "terminal.foreground": "#e6dfd0",
    "statusBar.background": "#1c1a2b",
    "statusBar.foreground": "#efe6d0",
    "statusBar.noFolderBackground": "#1c1a2b",
    "statusBar.debuggingBackground": "#c4362f",
    "statusBarItem.remoteBackground": "#3a3260",
    "menu.background": "#13111f",
    "menu.foreground": "#e6dfd0",
    "dropdown.background": "#13111f",
    "input.background": "#1c1a2b",
    "quickInput.background": "#13111f",
    "list.activeSelectionBackground": "#3a3260",
    "list.hoverBackground": "#1c1a2b",
    "focusBorder": "#e8b33c"
  }
}
