# Configuration de Bandini — copier vers `.env` puis ajuster.
#
#   cp .env.example .env
#
# ⚠️ Le vrai `.env` n'est PAS dans le depot (ignore par git). En production il
# vit dans /srv/bandini/shared/.env et systemd le lit (EnvironmentFile).

SECRET_KEY=change-cette-cle

SITE_NAME=Bandini
SITE_TAGLINE=Baie-des-Brumes t'attend. La police aussi.

# URL publique. En production : https://bandini.gestiondojo.ca
APP_BASE_URL=http://127.0.0.1:5400
APP_PORT=5400

# Interface d'ecoute du serveur de dev. Sans cette ligne : 0.0.0.0, ouvert au
# reseau local, pour jouer sur le telephone ou la tablette de la maison (meme
# wifi) — le terminal imprime l'adresse a taper sur l'appareil au demarrage.
# La decommenter la referme sur la machine, et c'est alors le seul cas ou la
# console interactive de Werkzeug s'allume.
# ⚠️ Ce fichier est charge avec `override=True` : une ligne ecrite ici gagne
# sur l'environnement, donc AUSSI sur le `env` des configurations VS Code.
# C'est pour ca qu'elle reste commentee — sinon « local seulement » ment.
# APP_HOST=127.0.0.1

# Dossier ou vit le tableau des scores (scores.json).
# En production : /srv/bandini/shared/donnees — HORS de la release.
DONNEES_DIR=donnees

# Cache navigateur des fichiers statiques, en secondes. 0 en dev, 604800 en prod.
STATIC_MAX_AGE=0

# Mode debug Flask — jamais en production.
FLASK_DEBUG=false
