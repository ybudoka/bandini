# Configuration de Bandini — copier vers `.env` puis ajuster.
#
#   cp .env.example .env
#
# ⚠️ Le vrai `.env` n'est PAS dans le depot (ignore par git). En production il
# vit dans /srv/bandini/shared/.env et systemd le lit (EnvironmentFile).

SECRET_KEY=change-cette-cle

SITE_NAME=Bandini
SITE_TAGLINE=Baie-des-Brumes t'attend. La police aussi.

# URL publique. En production : https://bandini.gestiondojo.ca
APP_BASE_URL=http://127.0.0.1:5400
APP_PORT=5400

# Dossier ou vit le tableau des scores (scores.json).
# En production : /srv/bandini/shared/donnees — HORS de la release.
DONNEES_DIR=donnees

# Cache navigateur des fichiers statiques, en secondes. 0 en dev, 604800 en prod.
STATIC_MAX_AGE=0

# Mode debug Flask — jamais en production.
FLASK_DEBUG=false
